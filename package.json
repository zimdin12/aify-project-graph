{
  "name": "aify-project-graph",
  "version": "0.7.1",
  "description": "On-demand codebase graph map for coding agents (Claude Code, Codex). Tree-sitter extraction → SQLite graph → compact MCP query verbs.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node ./scripts/run-vitest.mjs",
    "test:watch": "node ./scripts/run-vitest.mjs --watch",
    "validate:marketplace": "node ./scripts/validate-marketplace-package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "bin": {
    "apg": "./bin/apg.js",
    "aify-code-intel": "./bin/aify-code-intel.js"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.0.0",
    "cytoscape": "^3.30.4",
    "cytoscape-dagre": "^3.0.0",
    "cytoscape-expand-collapse": "^4.1.1",
    "cytoscape-fcose": "^2.2.0",
    "ngraph.graph": "^20.1.2",
    "ngraph.leiden": "^0.2.0",
    "proper-lockfile": "^4.1.2",
    "pyright": "^1.1.410",
    "tree-sitter": "^0.22.0",
    "tree-sitter-c": "^0.23.0",
    "tree-sitter-cpp": "^0.23.0",
    "tree-sitter-css": "^0.23.2",
    "tree-sitter-glsl": "^0.2.0",
    "tree-sitter-go": "^0.23.0",
    "tree-sitter-java": "^0.23.0",
    "tree-sitter-php": "^0.23.0",
    "tree-sitter-python": "^0.23.0",
    "tree-sitter-ruby": "^0.23.0",
    "tree-sitter-rust": "^0.23.0",
    "tree-sitter-typescript": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
