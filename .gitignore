node_modules/
.aify-graph/
coverage/
*.log
# FINISHED suite logs are evidence and must be reachable from git — a commit citing a log that
# gitignore silently dropped points at nothing, and the directory listing looks identical either way.
# Only docs/evidence/suite/ is un-ignored, and ONLY completed logs are copied there: writing a live
# log into the tracked tree made the repo dirty during its own run and turned packet-snapshot-line
# red. Use scripts/run-suite.mjs, which writes to scratch and copies the finished file.
# Gated by tests/unit/docs/evidence-is-not-ignored.test.js.
!docs/evidence/suite/*.log
.DS_Store
vendor/
.tmp/
.claude/
.codex
.codex/
bench-a1-live-*.json
reference/

# transient dogfood / bench test outputs
docs/dogfood/
bench/dogfood-*.json
bench/microbench-*.json
_dash.mjs
_rebuild.mjs

# raw per-arm output from scripts/self-review.mjs — evidence carrier, regenerated per run
.self-review-raw/
.refactor-guard-baseline.json
tests/fixtures/packet-routes/.git/
tests/fixtures/packet-routes/.aify-graph/graph.sqlite*
!tests/fixtures/packet-routes/.aify-graph/
!tests/fixtures/packet-routes/.aify-graph/*.json
.candidate-attempts/

# disposable per-arm worktrees and their custody manifests. Runtime state, never content —
# and leaving them tracked made an ORPHANED ARM read as a dirty tree, so the harness
# diagnosed a custody failure as 'commit your changes first'.
.self-review-worktrees/
.self-review-arms/
