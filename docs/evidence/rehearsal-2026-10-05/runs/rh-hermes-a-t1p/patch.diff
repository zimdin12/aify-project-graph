diff --git a/tests/unit/query/callers-scope-before-cap.test.js b/tests/unit/query/callers-scope-before-cap.test.js
new file mode 100644
index 0000000..3cac82d
--- /dev/null
+++ b/tests/unit/query/callers-scope-before-cap.test.js
@@ -0,0 +1,143 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { openDb } from '../../../mcp/stdio/storage/db.js';
+import { upsertNode } from '../../../mcp/stdio/storage/nodes.js';
+import { upsertEdge } from '../../../mcp/stdio/storage/edges.js';
+import { graphCallers } from '../../../mcp/stdio/query/verbs/callers.js';
+import { graphCallees } from '../../../mcp/stdio/query/verbs/callees.js';
+import { SCHEMA_VERSION } from '../../../mcp/stdio/storage/schema.js';
+import { EXTRACTOR_VERSION, PARSER_BUNDLE_VERSION } from '../../../mcp/stdio/freshness/manifest.js';
+
+// More out-of-scope callers than the SQL cap, inserted before the scoped caller.
+// Ranking verified edges first alone cannot fix this: the heuristic control must pass too.
+describe('graph_callers scopes before the fetch cap', () => {
+  let repoRoot;
+  let db;
+
+  const node = (id, file) => upsertNode(db, {
+    id, type: 'Function', label: id, file_path: file,
+    start_line: 1, end_line: 2, language: 'cpp', confidence: 1,
+    structural_fp: '', dependency_fp: '', extra: { qname: id },
+  });
+  const edge = (from, to, provenance = 'EXTRACTED') => upsertEdge(db, {
+    from_id: from, to_id: to, relation: 'CALLS',
+    // Deliberately not the caller declaration path: scope is defined by the node.
+    source_file: 'callsites/shared.cpp', source_line: 10,
+    confidence: provenance === 'LSP_VERIFIED' ? 1 : 0.8,
+    provenance, extractor: 'test',
+  });
+
+  beforeEach(async () => {
+    repoRoot = await mkdtemp(join(tmpdir(), 'apg-caller-scope-'));
+    execFileSync('git', ['init', '-q'], { cwd: repoRoot });
+    execFileSync('git', ['-c', 'user.email=test@test', '-c', 'user.name=test',
+      'commit', '--allow-empty', '-qm', 'init'], { cwd: repoRoot });
+    const commit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repoRoot, encoding: 'utf8' }).trim();
+    const graphDir = join(repoRoot, '.aify-graph');
+    db = openDb(join(graphDir, 'graph.sqlite'));
+    node('scopeTarget', 'lib/target.cpp');
+    for (let i = 0; i < 120; i += 1) {
+      node(`noise${i}`, `noise/caller${i}.cpp`);
+      edge(`noise${i}`, 'scopeTarget');
+    }
+    await writeFile(join(graphDir, 'manifest.json'), JSON.stringify({
+      status: 'ok', commit, indexedAt: new Date().toISOString(),
+      schemaVersion: SCHEMA_VERSION, extractorVersion: EXTRACTOR_VERSION,
+      parserBundleVersion: PARSER_BUNDLE_VERSION,
+      dirtyFiles: [], dirtyEdges: [], dirtyEdgeCount: 0, trustDirtyEdgeCount: 0,
+    }));
+  });
+
+  afterEach(async () => {
+    db?.close();
+    await rm(repoRoot, { recursive: true, force: true });
+  });
+
+  for (const depth of [1, 2]) {
+    for (const provenance of ['LSP_VERIFIED', 'EXTRACTED']) {
+      it(`finds a late ${provenance} caller at depth ${depth}`, async () => {
+        node('scopedCaller', 'wanted/caller.cpp');
+        edge('scopedCaller', 'scopeTarget', provenance);
+        const out = String(await graphCallers({ repoRoot, symbol: 'scopeTarget', file: 'wanted/', depth }));
+        expect(out).toContain('scopedCaller');
+        expect(out).toContain('wanted/caller.cpp:1');
+        expect(out).not.toContain('NO CALLERS');
+        expect(out).not.toContain('noise0');
+        expect(out).not.toContain('TRUNCATED');
+        if (provenance === 'LSP_VERIFIED') expect(out).toContain('[lsp✓]');
+      });
+    }
+  }
+
+  it('traverses out-of-scope intermediate callers to reach scoped ancestors', async () => {
+    node('scopedAncestor', 'wanted/ancestor.cpp');
+    edge('scopedAncestor', 'noise119', 'LSP_VERIFIED');
+    const out = String(await graphCallers({ repoRoot, symbol: 'scopeTarget', file: 'wanted/', depth: 2 }));
+    expect(out).toContain('scopedAncestor');
+    expect(out).not.toContain('NO CALLERS');
+    expect(out).not.toContain('noise119→');
+  });
+
+  it('preserves literal, case-sensitive prefixes and Windows path normalization', async () => {
+    node('literalCaller', 'wanted_%/caller.cpp');
+    edge('literalCaller', 'scopeTarget');
+    node('wildcardDecoy', 'wantedXY/caller.cpp');
+    edge('wildcardDecoy', 'scopeTarget');
+    node('caseDecoy', 'WANTED_%/caller.cpp');
+    edge('caseDecoy', 'scopeTarget');
+    const out = String(await graphCallers({ repoRoot, symbol: 'scopeTarget', file: 'wanted_%\\' }));
+    expect(out).toContain('literalCaller');
+    expect(out).not.toContain('wildcardDecoy');
+    expect(out).not.toContain('caseDecoy');
+  });
+
+  it('still discloses saturation within the requested scope and without a scope', async () => {
+    for (const file of ['noise/', undefined]) {
+      const out = String(await graphCallers({ repoRoot, symbol: 'scopeTarget', file, top_k: 10 }));
+      expect(out).toMatch(/TRUNCATED at least 90 more/);
+    }
+  });
+
+  it('keeps a genuine scoped absence with its trust caveat', async () => {
+    const out = String(await graphCallers({ repoRoot, symbol: 'scopeTarget', file: 'missing/' }));
+    expect(out).toContain('NO CALLERS from "missing/"');
+    expect(out).toContain('TRUST');
+  });
+
+  for (const depth of [1, 2]) {
+    it(`also scopes mirrored callee queries before the cap at depth ${depth}`, async () => {
+      for (let i = 0; i < 120; i += 1) edge('scopeTarget', `noise${i}`);
+      node('zzScopedCallee', 'wanted/callee.cpp');
+      edge('scopeTarget', 'zzScopedCallee');
+      const out = String(await graphCallees({ repoRoot, symbol: 'scopeTarget', file: 'wanted/', depth }));
+      expect(out).toContain('zzScopedCallee');
+      expect(out).not.toContain('NO CALLEES');
+      expect(out).not.toContain('TRUNCATED');
+    });
+  }
+
+  it('traverses out-of-scope intermediate callees', async () => {
+    for (let i = 0; i < 120; i += 1) edge('scopeTarget', `noise${i}`);
+    node('scopedDescendant', 'wanted/descendant.cpp');
+    edge('noise119', 'scopedDescendant');
+    const out = String(await graphCallees({ repoRoot, symbol: 'scopeTarget', file: 'wanted/', depth: 2 }));
+    expect(out).toContain('scopedDescendant');
+    expect(out).not.toContain('NO CALLEES');
+  });
+
+  it('scopes virtual-override callees before their separate fetch cap', async () => {
+    const override = (to) => upsertEdge(db, {
+      from_id: 'scopeTarget', to_id: to, relation: 'OVERRIDDEN_BY', provenance: 'INFERRED',
+    });
+    for (let i = 0; i < 120; i += 1) override(`noise${i}`);
+    node('scopedOverride', 'wanted/override.cpp');
+    override('scopedOverride');
+    const out = String(await graphCallees({ repoRoot, symbol: 'scopeTarget', file: 'wanted/' }));
+    expect(out).toContain('scopedOverride');
+    expect(out).not.toContain('NO CALLEES');
+    expect(out).toContain('1 OVERRIDDEN_BY callee');
+  });
+});
