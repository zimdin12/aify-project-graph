diff --git a/tests/unit/query/caller-callee-chain.test.js b/tests/unit/query/caller-callee-chain.test.js
index a952ddf..68eb92d 100644
--- a/tests/unit/query/caller-callee-chain.test.js
+++ b/tests/unit/query/caller-callee-chain.test.js
@@ -90,6 +90,55 @@ describe('graph_callers / graph_callees — recursive chain only', () => {
     await rm(repoRoot, { recursive: true, force: true });
   });
 
+  it.each([
+    ['callers', 1, graphCallers],
+    ['callers', 2, graphCallers],
+    ['callees', 1, graphCallees],
+    ['callees', 2, graphCallees],
+    ['overrides', 1, graphCallees],
+  ])('%s(depth=%i) applies directory scope before the fetch cap', async (direction, depth, query) => {
+    const node = (id, file) => upsertNode(db, {
+      id, type: 'Function', label: id, file_path: file,
+      start_line: 1, end_line: 2, language: 'cpp', confidence: 1,
+      extra: { qname: id },
+    });
+    const edge = (id, provenance) => upsertEdge(db, {
+      from_id: direction === 'callers' ? id : 'scopeTarget',
+      to_id: direction === 'callers' ? 'scopeTarget' : id,
+      relation: direction === 'overrides' ? 'OVERRIDDEN_BY' : 'CALLS', source_file: 'call-sites/elsewhere.cpp',
+      source_line: 1, confidence: 1, provenance, extractor: 'test',
+    });
+    node('scopeTarget', 'target/target.cpp');
+    for (let i = 0; i < 120; i += 1) {
+      node(`noise${i}`, `noise/${i}.cpp`);
+      edge(`noise${i}`, 'EXTRACTED');
+    }
+    node('scopedVerified', 'wanted_dir/verified.cpp');
+    edge('scopedVerified', 'LSP_VERIFIED');
+    // An unverified scoped edge must survive too: provenance ordering alone is not a fix.
+    node('scopedHeuristic', 'wanted_dir/heuristic.cpp');
+    edge('scopedHeuristic', 'EXTRACTED');
+    node('prefixLookalike', 'wantedXdir/lookalike.cpp');
+    edge('prefixLookalike', 'EXTRACTED');
+
+    const out = await query({ repoRoot, symbol: 'scopeTarget', depth, file: 'wanted_dir/', top_k: 20 });
+    expect(out).toContain('wanted_dir/verified.cpp');
+    expect(out).toContain('wanted_dir/heuristic.cpp');
+    expect(out).not.toContain('NO CALL');
+    expect(out).not.toContain('noise/');
+    expect(out).not.toContain('wantedXdir/');
+    expect(out).not.toMatch(/at least|fetch cap/i);
+    const missing = await query({ repoRoot, symbol: 'scopeTarget', depth, file: 'missing/' });
+    expect(missing).toContain(direction === 'callers' ? 'NO CALLERS from "missing/"' : 'NO CALLEES in "missing/"');
+  });
+
+  it('recursive scope does not prune an out-of-scope intermediate caller or callee', async () => {
+    const callers = await graphCallers({ repoRoot, symbol: 'LodMeshRenderer', depth: 2, file: 'src/renderScene' });
+    expect(callers).toContain('src/renderScene.cpp');
+    const callees = await graphCallees({ repoRoot, symbol: 'renderScene', depth: 2, file: 'src/LodMeshRenderer' });
+    expect(callees).toContain('src/LodMeshRenderer.cpp');
+  });
+
