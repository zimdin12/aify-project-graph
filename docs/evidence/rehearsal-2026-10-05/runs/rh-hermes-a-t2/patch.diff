diff --git a/tests/unit/query/health-call-coverage.test.js b/tests/unit/query/health-call-coverage.test.js
new file mode 100644
index 0000000..2d6cc18
--- /dev/null
+++ b/tests/unit/query/health-call-coverage.test.js
@@ -0,0 +1,90 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import { execFileSync } from 'node:child_process';
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { graphHealth } from '../../../mcp/stdio/query/verbs/health.js';
+import { openDb } from '../../../mcp/stdio/storage/db.js';
+import { ensureCodeIntelCollectionsTable } from '../../../mcp/stdio/storage/schema.js';
+
+let repo;
+afterEach(() => {
+  if (repo) rmSync(repo, { recursive: true, force: true });
+  repo = undefined;
+});
+
+function setup(verifiedCalls) {
+  repo = mkdtempSync(join(tmpdir(), 'apg-health-calls-'));
+  mkdirSync(join(repo, '.aify-graph'));
+  mkdirSync(join(repo, 'src'));
+  for (const file of ['a.cpp', 'b.cpp', 'a.js']) writeFileSync(join(repo, 'src', file), '');
+  execFileSync('git', ['init', '-q'], { cwd: repo, stdio: 'ignore' });
+  execFileSync('git', ['add', 'src'], { cwd: repo, stdio: 'ignore' });
+  execFileSync('git', ['-c', 'user.email=t@t', '-c', 'user.name=t', 'commit', '-qm', 'fixture'],
+    { cwd: repo, stdio: 'ignore' });
+  const commit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repo, encoding: 'utf8' }).trim();
+  writeFileSync(join(repo, '.aify-graph', 'manifest.json'), JSON.stringify({
+    commit, indexedAt: new Date().toISOString(), schemaVersion: 4,
+    extractorVersion: '0.1.0', status: 'ok', dirtyFiles: [], dirtyEdges: [], dirtyEdgeCount: 0,
+  }));
+  const db = openDb(join(repo, '.aify-graph', 'graph.sqlite'));
+  try {
+    ensureCodeIntelCollectionsTable(db);
+    db.run(`INSERT INTO code_intel_collections
+      (collection_id, provider, provider_version, project_root, language, status, collected_at, index_ready)
+      VALUES ('c1','cpp-clangd','0.1.0',$root,'cpp','ok',$at,1)`,
+    { root: repo, at: new Date().toISOString() });
+    const node = (id, file, lang) => db.run(`INSERT INTO nodes
+      (id,type,label,file_path,start_line,end_line,language,confidence,extra)
+      VALUES ($id,'Function',$id,$file,1,1,$lang,1,'{}')`, { id, file, lang });
+    node('cpp-a', 'src/a.cpp', 'cpp');
+    node('cpp-b', 'src/b.cpp', 'cpp');
+    node('vendor', 'vendor/a.cpp', 'cpp');
+    node('js', 'src/a.js', 'javascript');
+    let next = 0;
+    const edge = (from, relation, verified) => {
+      const to = `target-${next++}`;
+      node(to, 'src/a.cpp', 'cpp');
+      db.run(`INSERT INTO edges
+        (from_id,to_id,relation,source_file,source_line,confidence,provenance,extractor)
+        VALUES ($from,$to,$relation,'src/a.cpp',1,1,$provenance,'fixture')`,
+      { from, to, relation, provenance: verified ? 'LSP_VERIFIED' : 'EXTRACTED' });
+    };
+    // Two tracked C++ files exercise aggregation within the same language/scope bucket.
+    // source_file deliberately differs from some callers: scope follows the caller node,
+    // exactly as it does for the denominator, not a separate numerator predicate.
+    for (let i = 0; i < 19; i++) edge(i % 2 ? 'cpp-a' : 'cpp-b', 'CALLS', i < verifiedCalls);
+    for (let i = 0; i < 300; i++) edge('vendor', 'CALLS', true);
+    for (let i = 0; i < 400; i++) edge('js', 'CALLS', true);
+    for (let i = 0; i < 949 - verifiedCalls - 700; i++) edge('cpp-a', 'REFERENCES', true);
+  } finally {
+    db.close();
+  }
+}
+
+describe('graph_health uses the same CALLS population on both sides of coverage', () => {
+  it.each([0, 10, 19])('counts %i eligible verified calls, not all 949 verified edges', async (verified) => {
+    setup(verified);
+    const { codeIntel: ci } = await graphHealth({ repoRoot: repo });
+    expect(ci.available).toBe(true);
+    expect(ci.lspVerifiedEdges).toBe(949);
+    expect(ci.lspCallsTotal).toBe(719);
+    expect(ci.lspCallsVerifiable).toBe(19);
+    expect(ci.lspVerifiedVerifiableInScopeCalls).toBe(verified);
+    expect(ci.lspVerifiedPctOfVerifiableInScopeCalls).toBe(Math.round(verified / 19 * 100));
+    expect(ci.lspVerifiedPctOfCalls).toBe(ci.lspVerifiedPctOfVerifiableInScopeCalls);
+    expect(ci.lspVerifiedPctDenominator).toBe('verifiable_and_in_scope_calls');
+    expect(ci.lspOutOfScopeCalls.total).toBe(300);
+    expect(ci.lspUnverifiableCalls.total).toBe(400);
+  }, 30_000);
+
+  it('keeps unknown-scope fallback explicitly labelled and filters both sides identically', async () => {
+    setup(10);
+    rmSync(join(repo, '.git'), { recursive: true, force: true });
+    const { codeIntel: ci } = await graphHealth({ repoRoot: repo });
+    expect(ci.lspCallsVerifiable).toBe(319);
+    expect(ci.lspVerifiedVerifiableInScopeCalls).toBe(310);
+    expect(ci.lspVerifiedPctOfVerifiableInScopeCalls).toBe(Math.round(310 / 319 * 100));
+    expect(ci.lspVerifiedPctDenominator).toContain('SCOPE UNKNOWN');
+  }, 30_000);
+});
