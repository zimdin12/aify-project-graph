diff --git a/tests/unit/query/directory-scope-before-cap.test.js b/tests/unit/query/directory-scope-before-cap.test.js
new file mode 100644
index 0000000..193072d
--- /dev/null
+++ b/tests/unit/query/directory-scope-before-cap.test.js
@@ -0,0 +1,117 @@
+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { mkdirSync, writeFileSync } from 'node:fs';
+import { execFileSync } from 'node:child_process';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { openDb } from '../../../mcp/stdio/storage/db.js';
+import { upsertNode } from '../../../mcp/stdio/storage/nodes.js';
+import { upsertEdge } from '../../../mcp/stdio/storage/edges.js';
+import { graphCallers } from '../../../mcp/stdio/query/verbs/callers.js';
+import { graphCallees } from '../../../mcp/stdio/query/verbs/callees.js';
+
+for (const [direction, query] of [['callers', graphCallers], ['callees', graphCallees]]) {
+  describe(`${direction}: directory scope precedes the SQL fetch cap`, () => {
+    let repoRoot;
+    let db;
+    const node = (id, file_path) => ({
+      id, type: 'Function', label: id, file_path,
+      start_line: 1, end_line: 1, language: 'cpp', confidence: 1,
+      structural_fp: '', dependency_fp: '', extra: {},
+    });
+    const edge = (neighbor, target = 'target', provenance = 'INFERRED', relation = 'CALLS') => {
+      upsertEdge(db, {
+        from_id: direction === 'callers' ? neighbor : target,
+        to_id: direction === 'callers' ? target : neighbor,
+        relation, source_file: 'outside/call.cpp', source_line: 1,
+        confidence: 0.9, provenance, extractor: 'cpp',
+      });
+    };
+
+    beforeEach(async () => {
+      repoRoot = await mkdtemp(join(tmpdir(), 'apg-scope-cap-'));
+      const run = (...args) => execFileSync('git', ['-C', repoRoot, ...args], { stdio: 'ignore' });
+      run('init', '-q');
+      run('-c', 'user.email=t@t', '-c', 'user.name=t', 'commit', '--allow-empty', '-m', 'init');
+      const commit = execFileSync('git', ['-C', repoRoot, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
+      mkdirSync(join(repoRoot, '.aify-graph'), { recursive: true });
+      writeFileSync(join(repoRoot, '.aify-graph', 'manifest.json'), JSON.stringify({
+        commit, indexedAt: new Date().toISOString(), nodes: 0, edges: 0,
+        schemaVersion: 4, extractorVersion: '0.1.0', status: 'ok',
+        dirtyFiles: [], dirtyEdges: [], dirtyEdgeCount: 0,
+      }));
+      db = openDb(join(repoRoot, '.aify-graph', 'graph.sqlite'));
+      upsertNode(db, node('target', 'outside/target.cpp'));
+      // Insert enough out-of-scope rows to exhaust the fetch cap BEFORE the matching row.
+      for (let i = 0; i < 120; i += 1) {
+        upsertNode(db, node(`heuristic${i}`, `outside/${i}.cpp`));
+        edge(`heuristic${i}`);
+      }
+    });
+
+    afterEach(async () => {
+      db?.close();
+      await rm(repoRoot, { recursive: true, force: true });
+    });
+
+    for (const depth of [1, 2]) {
+      for (const provenance of ['LSP_VERIFIED', 'INFERRED']) {
+        it(`finds the scoped ${provenance} neighbor at depth=${depth}`, async () => {
+          upsertNode(db, node('scopedNeighbor', 'wanted/caller.cpp'));
+          edge('scopedNeighbor', 'target', provenance);
+          const out = await query({ repoRoot, symbol: 'target', file: 'wanted/', depth });
+          expect(out).toContain('scopedNeighbor');
+          expect(out).toContain('wanted/caller.cpp:1');
+          expect(out).not.toContain('NO CALL');
+          expect(out).not.toContain('heuristic0');
+          // The out-of-scope rows must not make a one-row scoped answer look truncated.
+          expect(out).not.toMatch(/^(TRUNCATED |\+)/m);
+          if (provenance === 'LSP_VERIFIED') expect(out).toContain('[lsp✓]');
+        });
+      }
+      it(`still reports saturation when the scoped set exceeds the cap at depth=${depth}`, async () => {
+        for (let i = 0; i < 120; i += 1) {
+          upsertNode(db, node(`heuristic${i}`, `wanted/${i}.cpp`));
+        }
+        const out = await query({ repoRoot, symbol: 'target', file: 'wanted/', depth, top_k: 1 });
+        const marker = out.split('\n').find((line) => /^(TRUNCATED |\+)/.test(line));
+        expect(marker).toMatch(/at least 99 more/);
+      });
+    }
+
+    it('traverses an out-of-scope intermediate to find an in-scope depth-2 neighbor', async () => {
+      upsertNode(db, node('scopedNeighbor', 'wanted/caller.cpp'));
+      edge('scopedNeighbor', 'heuristic0', 'LSP_VERIFIED');
+      const direct = await query({ repoRoot, symbol: 'target', file: 'wanted/', depth: 1 });
+      expect(direct).toContain('NO CALL');
+      const transitive = await query({ repoRoot, symbol: 'target', file: 'wanted/', depth: 2 });
+      expect(transitive).toContain('scopedNeighbor');
+      expect(transitive).not.toContain('NO CALL');
+    });
+
+    it('preserves literal, case-sensitive prefix matching and Windows path normalization', async () => {
+      upsertNode(db, node('scopedNeighbor', 'Wanted_%/caller.cpp'));
+      edge('scopedNeighbor');
+      upsertNode(db, node('wrongCase', 'wanted_%/caller.cpp'));
+      edge('wrongCase');
+      upsertNode(db, node('wildcardDecoy', 'WantedXY/caller.cpp'));
+      edge('wildcardDecoy');
+      const out = await query({ repoRoot, symbol: 'target', file: 'Wanted_%\\', depth: 2 });
+      expect(out).toContain('scopedNeighbor');
+      expect(out).not.toContain('wrongCase');
+      expect(out).not.toContain('wildcardDecoy');
+    });
+
+    if (direction === 'callees') {
+      it('scopes virtual overrides before their independent fetch cap', async () => {
+        for (let i = 0; i < 120; i += 1) edge(`heuristic${i}`, 'target', 'INFERRED', 'OVERRIDDEN_BY');
+        upsertNode(db, node('scopedOverride', 'wanted/override.cpp'));
+        edge('scopedOverride', 'target', 'INFERRED', 'OVERRIDDEN_BY');
+        const out = await query({ repoRoot, symbol: 'target', file: 'wanted/' });
+        expect(out).toContain('scopedOverride');
+        expect(out).not.toContain('NO CALLEES');
+        expect(out).not.toContain('heuristic0');
+      });
+    }
+  });
+}
