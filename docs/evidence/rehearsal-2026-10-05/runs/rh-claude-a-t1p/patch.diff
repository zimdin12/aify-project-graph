diff --git a/tests/unit/query/truncation-honesty.test.js b/tests/unit/query/truncation-honesty.test.js
index 67ad9cd..c1b08f1 100644
--- a/tests/unit/query/truncation-honesty.test.js
+++ b/tests/unit/query/truncation-honesty.test.js
@@ -80,6 +80,29 @@ describe('truncation honesty', () => {
     expect(out).toMatch(/FLOOR/);
   });
 
+  // The `file` scope filter ran AFTER the 101-row SQL cap: 120 heuristic callers elsewhere filled
+  // the cap and the lone LSP_VERIFIED caller under `file` was never fetched -> false NO CALLERS.
+  it('graph_callers file scope finds a caller the fetch cap would have crowded out', async () => {
+    const db = openDb(join(repoRoot, '.aify-graph', 'graph.sqlite'));
+    insertNode(db, { id: 'callee', type: 'Function', label: 'crowded_target', file_path: 'core/target.cpp' });
+    for (let i = 0; i < 120; i++) {
+      insertNode(db, { id: `h${i}`, type: 'Function', label: `heur_${i}`, file_path: `heur/h${i}.cpp` });
+      insertEdge(db, { from_id: `h${i}`, to_id: 'callee', relation: 'CALLS', source_file: `heur/h${i}.cpp`, confidence: 0.5, provenance: 'INFERRED' });
+    }
+    insertNode(db, { id: 'real', type: 'Function', label: 'verified_caller', file_path: 'app/main.cpp' });
+    insertEdge(db, { from_id: 'real', to_id: 'callee', relation: 'CALLS', source_file: 'app/main.cpp', provenance: 'LSP_VERIFIED' });
+    db.close();
+
+    for (const depth of [1, 2]) {
+      const out = await graphCallers({ repoRoot, symbol: 'crowded_target', file: 'app/', depth });
+      expect(out).not.toMatch(/NO CALLERS/);
+      expect(out).toContain('verified_caller');
+      expect(out).not.toContain('heur_');
+    }
+    // negative control: a directory with no caller still answers absence
+    expect(await graphCallers({ repoRoot, symbol: 'crowded_target', file: 'nowhere/' })).toMatch(/NO CALLERS from "nowhere\/"/);
+  });
+
