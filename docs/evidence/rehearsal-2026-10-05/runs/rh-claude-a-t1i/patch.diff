+         WHERE e.to_id IN (${placeholders}) AND e.relation IN (${EXECUTION_RELATIONS.map((relation) => `'${relation}'`).join(',')}) ${fileClause}
          LIMIT ${EDGE_FETCH_CAP + 1}`,
         params
       );
