     const params = {};
     targetIds.forEach((id, i) => { params[`t${i}`] = id; });
 
+    // ⛔ THE DIRECTORY FILTER MUST RUN IN SQL, BEFORE THE FETCH CAP. Applied only after the capped,
+    // unordered fetch, ~120 heuristic callers elsewhere filled the cap and evicted the single
+    // caller under `file`, which then answered "NO CALLERS from <dir>" for a dir that has one.
+    // Same predicate as the old JS `startsWith` (caller's declaration file).
+    let fileClause = '';
+    if (file) {
+      params.fileScope = file;
+      fileClause = 'AND substr(n.file_path, 1, length($fileScope)) = $fileScope';
+    }
+
     // The SQL cap is a HARDER ceiling than the top_k display budget: past it the
     // edges were never fetched, so raising top_k cannot reveal them and the trust
