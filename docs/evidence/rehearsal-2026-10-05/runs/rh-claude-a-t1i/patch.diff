diff --git a/tests/unit/query/truncation-honesty.test.js b/tests/unit/query/truncation-honesty.test.js
index 67ad9cd..aab67c6 100644
--- a/tests/unit/query/truncation-honesty.test.js
+++ b/tests/unit/query/truncation-honesty.test.js
@@ -95,4 +95,22 @@ describe('truncation honesty', () => {
     expect(out).toMatch(/declaration, not a call site/i);
     expect(out).toMatch(/code_intel_references/);
   });
+
+  it('graph_callers applies the file filter before the fetch cap, so a lone caller in the dir is not evicted', async () => {
+    const db = openDb(join(repoRoot, '.aify-graph', 'graph.sqlite'));
+    insertNode(db, { id: 'callee', type: 'Function', label: 'shared_target', file_path: 'core/t.cpp' });
+    // 120 > the 100-edge SQL cap, all outside the queried dir, inserted first.
+    for (let i = 0; i < 120; i++) {
+      insertNode(db, { id: `noise${i}`, type: 'Function', label: `noise_${i}`, file_path: `noisy/n${i}.cpp` });
+      insertEdge(db, { from_id: `noise${i}`, to_id: 'callee', relation: 'CALLS', source_file: `noisy/n${i}.cpp`, confidence: 0.5 });
+    }
+    insertNode(db, { id: 'lone', type: 'Function', label: 'lone_caller', file_path: 'quiet/q.cpp' });
+    insertEdge(db, { from_id: 'lone', to_id: 'callee', relation: 'CALLS', source_file: 'quiet/q.cpp', provenance: 'LSP_VERIFIED' });
+    db.close();
+
+    const out = await graphCallers({ repoRoot, symbol: 'shared_target', file: 'quiet/' });
+
+    expect(out).toContain('lone_caller');
+    expect(out).not.toMatch(/NO CALLERS/);
+  });
 });
