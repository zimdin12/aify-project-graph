diff --git a/tests/unit/query/caller-callee-fetch-scope.test.js b/tests/unit/query/caller-callee-fetch-scope.test.js
new file mode 100644
index 0000000..48ed280
--- /dev/null
+++ b/tests/unit/query/caller-callee-fetch-scope.test.js
@@ -0,0 +1,118 @@
+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { openDb } from '../../../mcp/stdio/storage/db.js';
+import { upsertNode } from '../../../mcp/stdio/storage/nodes.js';
+import { upsertEdge } from '../../../mcp/stdio/storage/edges.js';
+import { graphCallers } from '../../../mcp/stdio/query/verbs/callers.js';
+import { graphCallees } from '../../../mcp/stdio/query/verbs/callees.js';
+import { SCHEMA_VERSION } from '../../../mcp/stdio/storage/schema.js';
+import { EXTRACTOR_VERSION, PARSER_BUNDLE_VERSION } from '../../../mcp/stdio/freshness/manifest.js';
+
+for (const [name, query, incoming] of [
+  ['callers', graphCallers, true],
+  ['callees', graphCallees, false],
+]) {
+  describe(`${name}: scope and priority precede the fetch cap`, () => {
+    let repoRoot;
+    let db;
+    const node = (id, file) => upsertNode(db, {
+      id, label: id, type: 'Function', file_path: file, start_line: 1, end_line: 2,
+      language: 'cpp', confidence: 1, structural_fp: '', dependency_fp: '', extra: {},
+    });
+    const edge = (near, far, provenance = 'EXTRACTED', relation = 'CALLS') => upsertEdge(db, {
+      from_id: incoming ? far : near, to_id: incoming ? near : far, relation,
+      // Deliberately distinct from the endpoint definition used for file scope.
+      source_file: 'call-sites.cpp', source_line: 1, confidence: 0.9,
+      provenance, extractor: 'test',
+    });
+    const fanout = (file) => {
+      for (let i = 0; i < 120; i++) {
+        const id = `heuristic_${String(i).padStart(3, '0')}`;
+        node(id, `${file}/${id}.cpp`);
+        edge('target', id);
+      }
+    };
+
+    beforeEach(async () => {
+      repoRoot = await mkdtemp(join(tmpdir(), 'apg-fetch-scope-'));
+      execFileSync('git', ['init', '-q'], { cwd: repoRoot });
+      execFileSync('git', ['-c', 'user.email=t@t', '-c', 'user.name=t', 'commit', '--allow-empty', '-qm', 'init'], { cwd: repoRoot });
+      const commit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repoRoot, encoding: 'utf8' }).trim();
+      db = openDb(join(repoRoot, '.aify-graph', 'graph.sqlite'));
+      node('target', 'src/target.cpp');
+      await writeFile(join(repoRoot, '.aify-graph', 'manifest.json'), JSON.stringify({
+        status: 'ok', commit, indexedAt: new Date().toISOString(),
+        schemaVersion: SCHEMA_VERSION, extractorVersion: EXTRACTOR_VERSION,
+        parserBundleVersion: PARSER_BUNDLE_VERSION, dirtyFiles: [], dirtyEdges: [],
+        dirtyEdgeCount: 0, trustDirtyEdgeCount: 0,
+      }));
+    });
+    afterEach(async () => {
+      db.close();
+      await rm(repoRoot, { recursive: true, force: true });
+    });
+
+    for (const depth of [1, 2]) {
+      for (const provenance of ['LSP_VERIFIED', 'EXTRACTED']) {
+        it(`finds a ${provenance} scoped edge after 120 out-of-scope edges at depth ${depth}`, async () => {
+          fanout('bulk');
+          node('scoped_match', 'selected/match.cpp');
+          edge('target', 'scoped_match', provenance);
+          const out = await query({ repoRoot, symbol: 'target', depth, file: 'selected/', top_k: 1 });
+          expect(out).toContain('scoped_match');
+          expect(out).toContain('selected/match.cpp:1');
+          expect(out).not.toMatch(/NO CALLERS|NO CALLEES|heuristic_\d|TRUNCATED/);
+          if (provenance === 'LSP_VERIFIED') expect(out).toContain('[lsp✓]');
+        });
+      }
+
+      it(`keeps verified edges ahead of the unscoped cap at depth ${depth}`, async () => {
+        fanout('bulk');
+        node('verified_match', 'selected/match.cpp');
+        edge('target', 'verified_match', 'LSP_VERIFIED');
+        const out = await query({ repoRoot, symbol: 'target', depth, top_k: 1 });
+        expect(out).toContain('verified_match');
+        expect(out).toContain('[lsp✓]');
+        expect(out).toContain('TRUNCATED at least 99 more');
+      });
+    }
+
+    it('traverses through an out-of-scope intermediate node', async () => {
+      fanout('bulk');
+      node('bridge', 'bulk/bridge.cpp');
+      node('indirect_match', 'selected/indirect.cpp');
+      edge('target', 'bridge');
+      edge('bridge', 'indirect_match');
+      const out = await query({ repoRoot, symbol: 'target', depth: 2, file: 'selected/' });
+      expect(out).toContain('indirect_match');
+      expect(out).not.toContain('bulk/bridge.cpp:1');
+    });
+
+    it('uses a literal, case-sensitive prefix, including SQL wildcard characters', async () => {
+      node('literal_match', 'Selected_%/match.cpp');
+      node('wildcard_decoy', 'Selected_ab/match.cpp');
+      node('case_decoy', 'selected_%/match.cpp');
+      for (const id of ['literal_match', 'wildcard_decoy', 'case_decoy']) edge('target', id);
+      const out = await query({ repoRoot, symbol: 'target', file: 'Selected_%\\' });
+      expect(out).toContain('literal_match');
+      expect(out).not.toMatch(/wildcard_decoy|case_decoy/);
+    });
+
+    if (!incoming) {
+      it('scopes virtual overrides before their separate cap', async () => {
+        for (let i = 0; i < 120; i++) {
+          node(`override_${i}`, `bulk/override_${i}.cpp`);
+          edge('target', `override_${i}`, 'INFERRED', 'OVERRIDDEN_BY');
+        }
+        node('scoped_override', 'selected/override.cpp');
+        edge('target', 'scoped_override', 'INFERRED', 'OVERRIDDEN_BY');
+        const out = await query({ repoRoot, symbol: 'target', file: 'selected/' });
+        expect(out).toContain('scoped_override');
+        expect(out).not.toMatch(/NO CALLEES|bulk\/override/);
+      });
+    }
+  });
+}
