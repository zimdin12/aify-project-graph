diff --git a/tests/unit/query/health-call-coverage.test.js b/tests/unit/query/health-call-coverage.test.js
new file mode 100644
index 0000000..1391d3b
--- /dev/null
+++ b/tests/unit/query/health-call-coverage.test.js
@@ -0,0 +1,97 @@
+import { describe, it, expect, afterEach } from 'vitest';
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { openDb } from '../../../mcp/stdio/storage/db.js';
+import { ensureCodeIntelCollectionsTable } from '../../../mcp/stdio/storage/schema.js';
+import { graphHealth } from '../../../mcp/stdio/query/verbs/health.js';
+
+let repo;
+afterEach(() => {
+  if (repo) rmSync(repo, { recursive: true, force: true });
+  repo = undefined;
+});
+
+function fixture({ calls = 19, verifiedCalls = 19, references = 930, excludedCalls = 0 } = {}) {
+  repo = mkdtempSync(join(tmpdir(), 'apg-call-cov-'));
+  mkdirSync(join(repo, '.aify-graph'));
+  execFileSync('git', ['init', '-q', repo]);
+  for (const file of ['a.cpp', 'b.cpp', 'a.js']) writeFileSync(join(repo, file), '// fixture\n');
+  execFileSync('git', ['-C', repo, 'add', 'a.cpp', 'b.cpp', 'a.js']);
+  execFileSync('git', ['-C', repo, '-c', 'user.email=t@t', '-c', 'user.name=t', 'commit', '-qm', 'fixture']);
+  const commit = execFileSync('git', ['-C', repo, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();
+  writeFileSync(join(repo, '.aify-graph', 'manifest.json'), JSON.stringify({
+    commit, indexedAt: new Date().toISOString(), schemaVersion: 4,
+    extractorVersion: '0.1.0', status: 'ok', dirtyFiles: [], dirtyEdges: [], dirtyEdgeCount: 0,
+  }));
+  const db = openDb(join(repo, '.aify-graph', 'graph.sqlite'));
+  try {
+    ensureCodeIntelCollectionsTable(db);
+    const node = (id, file, language) => db.run(
+      `INSERT INTO nodes (id,type,label,file_path,start_line,end_line,language,confidence,extra)
+       VALUES ($id,'Function',$id,$file,1,1,$language,1,'{}')`, { id, file, language });
+    node('a', 'a.cpp', 'cpp');
+    node('b', 'b.cpp', 'cpp');
+    node('js', 'a.js', 'javascript');
+    node('vendor', 'vendor.cpp', 'cpp');
+    let next = 0;
+    const edge = (from, relation, verified) => {
+      const id = `target${next++}`;
+      node(id, 'b.cpp', 'cpp');
+      db.run(
+        `INSERT INTO edges (from_id,to_id,relation,source_file,source_line,confidence,provenance)
+         VALUES ($from,$to,$relation,$file,1,1,$provenance)`, {
+          from, to: id, relation,
+          file: from === 'js' ? 'a.js' : from === 'vendor' ? 'vendor.cpp' : `${from}.cpp`,
+          provenance: verified ? 'LSP_VERIFIED' : 'EXTRACTED',
+        });
+    };
+    for (let i = 0; i < calls; i++) edge(i % 2 ? 'b' : 'a', 'CALLS', i < verifiedCalls);
+    for (let i = 0; i < references; i++) edge('a', 'REFERENCES', true);
+    for (let i = 0; i < excludedCalls; i++) {
+      edge('vendor', 'CALLS', true);
+      edge('js', 'CALLS', true);
+    }
+    db.run(
+      `INSERT INTO code_intel_collections
+       (collection_id,provider,provider_version,project_root,language,status,collected_at,index_ready)
+       VALUES ('c1','cpp-clangd','0.1.0',$root,'cpp','ok',$at,1)`,
+      { root: repo, at: new Date().toISOString() });
+  } finally { db.close(); }
+}
+
+describe('graph_health CALLS coverage uses matching populations', () => {
+  it('949 verified edges over 19 verifiable calls is not 4995% coverage', async () => {
+    fixture();
+    const { codeIntel: ci } = await graphHealth({ repoRoot: repo });
+    expect(ci.lspVerifiedEdges).toBe(949);
+    expect(ci.lspCallsVerifiable).toBe(19);
+    expect(ci.lspVerifiedVerifiableInScopeCalls).toBe(19);
+    expect(ci.lspVerifiedPctOfVerifiableInScopeCalls).toBe(100);
+    expect(ci.lspVerifiedPctOfCalls).toBe(100);
+  });
+
+  it('excludes verified out-of-scope and non-verifiable calls from partial coverage', async () => {
+    fixture({ verifiedCalls: 5, excludedCalls: 10 });
+    const { codeIntel: ci } = await graphHealth({ repoRoot: repo });
+    expect(ci.lspVerifiedEdges).toBe(955);
+    expect(ci.lspCallsTotal).toBe(39);
+    expect(ci.lspCallsVerifiable).toBe(19);
+    expect(ci.lspVerifiedVerifiableInScopeCalls).toBe(5);
+    expect(ci.lspVerifiedPctOfVerifiableInScopeCalls).toBe(26);
+    expect(ci.lspVerifiedPctOfCalls).toBe(26);
+    expect(ci.lspOutOfScopeCalls.total).toBe(10);
+    expect(ci.lspUnverifiableCalls.total).toBe(10);
+  });
+
+  it('reports zero with no eligible calls even when verified edges exist', async () => {
+    fixture({ calls: 0, verifiedCalls: 0, references: 2, excludedCalls: 1 });
+    const { codeIntel: ci } = await graphHealth({ repoRoot: repo });
+    expect(ci.lspVerifiedEdges).toBe(4);
+    expect(ci.lspCallsVerifiable).toBe(0);
+    expect(ci.lspVerifiedVerifiableInScopeCalls).toBe(0);
+    expect(ci.lspVerifiedPctOfVerifiableInScopeCalls).toBe(0);
+    expect(ci.lspVerifiedPctOfCalls).toBe(0);
+  });
+});
