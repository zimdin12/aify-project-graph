diff --git a/tests/unit/query/callers-file-scope-before-cap.test.js b/tests/unit/query/callers-file-scope-before-cap.test.js
new file mode 100644
index 0000000..a3bc587
--- /dev/null
+++ b/tests/unit/query/callers-file-scope-before-cap.test.js
@@ -0,0 +1,54 @@
+// graph_callers `file` scope must be applied BEFORE the 100-row SQL fetch cap. Filtering after it
+// answered `NO CALLERS from "<dir>"` for a directory that holds a caller whenever >100 callers
+// elsewhere filled the cap first.
+import { describe, expect, it, beforeEach, afterEach } from 'vitest';
+import { mkdtemp, rm, mkdir } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { openDb } from '../../../mcp/stdio/storage/db.js';
+import { graphCallers } from '../../../mcp/stdio/query/verbs/callers.js';
+
+function insertNode(db, node) {
+  db.run(
+    `INSERT INTO nodes (id, type, label, file_path, start_line, end_line, language, confidence, extra)
+     VALUES ($id, $type, $label, $file_path, $start_line, $end_line, $language, $confidence, $extra)`,
+    { start_line: 1, end_line: 1, language: 'cpp', confidence: 1, extra: '{}', ...node });
+}
+
+function insertEdge(db, edge) {
+  db.run(
+    `INSERT INTO edges (from_id, to_id, relation, source_file, source_line, confidence, provenance, extractor)
+     VALUES ($from_id, $to_id, $relation, $source_file, $source_line, $confidence, $provenance, $extractor)`,
+    { source_line: 1, confidence: 1, provenance: 'EXTRACTED', extractor: 'cpp', ...edge });
+}
+
+describe('graph_callers file scope vs the fetch cap', () => {
+  let repoRoot;
+  beforeEach(async () => {
+    repoRoot = await mkdtemp(join(tmpdir(), 'apg-callers-scope-'));
+    await mkdir(join(repoRoot, '.aify-graph'), { recursive: true });
+  });
+  afterEach(async () => { try { await rm(repoRoot, { recursive: true, force: true }); } catch {} });
+
+  it('finds the lone caller in a directory when 120 callers elsewhere exceed the cap', async () => {
+    const db = openDb(join(repoRoot, '.aify-graph', 'graph.sqlite'));
+    insertNode(db, { id: 'target', type: 'Function', label: 'zap_target', file_path: 'core/zap.cpp' });
+    for (let i = 0; i < 120; i++) {
+      insertNode(db, { id: `h${i}`, type: 'Function', label: `heur_caller_${i}`, file_path: `bulk/h${i}.cpp` });
+      insertEdge(db, { from_id: `h${i}`, to_id: 'target', relation: 'CALLS', source_file: `bulk/h${i}.cpp`, confidence: 0.5, provenance: 'HEURISTIC' });
+    }
+    // Inserted LAST so an unordered capped fetch drops it.
+    insertNode(db, { id: 'lsp', type: 'Function', label: 'verified_caller', file_path: 'app/main.cpp' });
+    insertEdge(db, { from_id: 'lsp', to_id: 'target', relation: 'CALLS', source_file: 'app/main.cpp', provenance: 'LSP_VERIFIED' });
+    db.close();
+
+    const scoped = await graphCallers({ repoRoot, symbol: 'zap_target', file: 'app/' });
+    expect(scoped).not.toMatch(/NO CALLERS/);
+    expect(scoped).toContain('verified_caller');
+    expect(scoped).not.toContain('heur_caller_');
+
+    // Control: a directory with no callers still reports absence.
+    const empty = await graphCallers({ repoRoot, symbol: 'zap_target', file: 'nowhere/' });
+    expect(empty).toMatch(/NO CALLERS from "nowhere\/"/);
+  });
+});
