@@ -80,6 +80,25 @@ describe('truncation honesty', () => {
     expect(out).toMatch(/FLOOR/);
   });
 
+  it('graph_callers file scope finds a caller that sits past the fetch cap in another directory', async () => {
+    const db = openDb(join(repoRoot, '.aify-graph', 'graph.sqlite'));
+    insertNode(db, { id: 'callee', type: 'Function', label: 'shared_target', file_path: 'core/t.cpp' });
+    // 120 heuristic callers in one directory fill the 100-row SQL cap...
+    for (let i = 0; i < 120; i++) {
+      insertNode(db, { id: `h${i}`, type: 'Function', label: `bulk_caller_${i}`, file_path: `bulk/b${i}.cpp` });
+      insertEdge(db, { from_id: `h${i}`, to_id: 'callee', relation: 'CALLS', source_file: `bulk/b${i}.cpp`, provenance: 'INFERRED' });
+    }
+    // ...and the one verified caller lives elsewhere, inserted last.
+    insertNode(db, { id: 'v', type: 'Function', label: 'verified_caller', file_path: 'app/v.cpp' });
+    insertEdge(db, { from_id: 'v', to_id: 'callee', relation: 'CALLS', source_file: 'app/v.cpp', provenance: 'LSP_VERIFIED' });
+    db.close();
+
+    const out = await graphCallers({ repoRoot, symbol: 'shared_target', file: 'app/' });
+
+    expect(out).not.toMatch(/NO CALLERS/);
+    expect(out).toContain('verified_caller');
+  });
+
